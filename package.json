{
    "name": "tz",
    "version": "1.0.0",
    "description": "Промо-лендинг Selector — тестовое задание",
    "main": "gulpfile.js",
    "type": "module",
    "scripts": {
        "dev": "gulp",
        "build": "gulp build --build",
        "zip": "gulp deployZIP --build",
        "deploy": "gulp deployFTP --build",
        "svgSprive": "gulp svgSpriteTask",
        "lint": "npm run lint:css && npm run lint:js",
        "lint:css": "stylelint \"src/**/*.scss\"",
        "lint:js": "eslint \"src/js/**/*.js\" \"src/components/**/*.js\"",
        "lint:fix": "stylelint \"src/**/*.scss\" --fix && eslint \"src/js/**/*.js\" \"src/components/**/*.js\" --fix",
        "format": "prettier --write \"src/**/*.{js,scss,json}\"",
        "format:check": "prettier --check \"src/**/*.{js,scss,json}\""
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "gulp-cli": "^2.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "browser-sync": "latest",
        "del": "6.1.1",
        "eslint": "^10.6.0",
        "globals": "^17.7.0",
        "gulp": "latest",
        "gulp-autoprefixer": "latest",
        "gulp-clean-css": "latest",
        "gulp-esbuild": "^0.15.0",
        "gulp-file-include": "latest",
        "gulp-fonter-fix": "latest",
        "gulp-group-css-media-queries": "latest",
        "gulp-if": "latest",
        "gulp-imagemin": "latest",
        "gulp-newer": "latest",
        "gulp-notify": "latest",
        "gulp-plumber": "latest",
        "gulp-pug": "latest",
        "gulp-rename": "latest",
        "gulp-replace": "latest",
        "gulp-sass": "latest",
        "gulp-svg-sprite": "^1.5.0",
        "gulp-ttf2woff2": "latest",
        "gulp-util": "latest",
        "gulp-version-number": "latest",
        "gulp-webp": "latest",
        "gulp-webp-html-nosvg": "latest",
        "gulp-webpcss": "latest",
        "gulp-zip": "latest",
        "prettier": "^3.9.4",
        "sass": "latest",
        "stylelint": "^17.14.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "vinyl-ftp": "latest",
        "webp-converter": "2.2.3"
    }
}
